{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "OWNER_EMAIL",
        "MONGODB_URI_AUTH",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "BETTER_AUTH_SECRET",
        "AUTH_BASE_URL",
        "NEXT_PUBLIC_AUTH_BASE_URL",
        "EMAIL_HOST",
        "EMAIL_PASSWORD",
        "NO_REPLY_EMAIL",
        "CONTACT_EMAIL",

        "MONGODB_URI_IMAGEUPLOADS",
        "MONGODB_URI_SHORTURLS",
        "SHORT_URL",
        "URL_SHORTENER_TOKEN",

        "PORT",
        "HOST",
        "CLIENT_URLS",
        "SOCKET_CLIENT_URLS",

        "BASE_URL",

        "AUTH_CLIENT_URLS",

        "MONGODB_URI_ANIPIC",
        "DOWNLOAD_SECRET",
        "DOWNLOAD_BASE",

        "ROOT_URL",
        "WHERE_TO_REDIRECT_AFTER_PROCESSING",

        "IMGUR_IMAGE_URL",
        "IMGUR_CLIENT_ID_1",
        "IMGUR_CLIENT_SECRET_1",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_BASE_URL",

        "APP_WEB_URL",
        "APP_API_URL",
        "APP_TOOLS_URL",
        "APP_ANIPIC_URL",
        "APP_URL_SHORTENER_URL"
      ]
    },
    "start": {
      "dependsOn": ["^start"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["lint", "typecheck"],
      "outputs": []
    }
  }
}
