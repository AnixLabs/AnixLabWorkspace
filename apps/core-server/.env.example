################################################
######### Global Environment Variables #########
################################################

# Node environment
NODE_ENV=production

# Owner details
OWNER_EMAIL=owner@anixlab.in

# Database URIs
MONGODB_URI_AUTH=mongodb://localhost:27017/
MONGODB_URI_SHORTURLS=mongodb://localhost:27017/
MONGODB_URI_IMAGEUPLOADS=mongodb://localhost:27017/

# Auth Details
AUTH_GOOGLE_ID=<auth-google-id>
AUTH_GOOGLE_SECRET=<auth-google-secret>
BETTER_AUTH_SECRET=<better-auth-secret> # min 32 chars, same as @shared/auth
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3007
ALLOW_AUTH_ORIGIN_DIVIDE_BY_COMMA="http://localhost:3000,http://localhost:3002"

# Short URL Details
SHORT_URL="http://localhost:3001"
URL_SHORTENER_TOKEN=<url-shortener-token>

# Zoho Mail
EMAIL_HOST=smtp.zoho.in
EMAIL_PASSWORD=<email-password>
NO_REPLY_EMAIL="no-reply@anixlab.in"
CONTACT_EMAIL="contact@anixlab.in"



################################################
######### Local Environment Variables #########
################################################

# Server
PORT=4001
HOST="0.0.0.0"

# HTTP allowed origins (comma-separated)
# e.g. http://localhost:3000,https://app.example.com
CLIENT_URLS="http://localhost:3000"

# Socket.IO allowed origins (comma-separated, usually just the game client)
# e.g. http://localhost:3002
SOCKET_CLIENT_URLS="http://localhost:3002"

# Better Auth — should point to this server's /api/auth
BETTER_AUTH_URL="/api/auth"
