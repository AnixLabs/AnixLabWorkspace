################################################
######### Global Environment Variables #########
################################################

# production or development
NODE_ENV=production

# owner details
OWNER_EMAIL=<owner_email>

# Database URIs
MONGODB_URI_AUTH=<mongodb_uri>

# Auth Details
AUTH_GOOGLE_ID=<google_client_id>
AUTH_GOOGLE_SECRET=<google_client_secret>
BETTER_AUTH_SECRET=<better_auth_secret>
NEXT_PUBLIC_AUTH_BASE_URL=api.anixlab.in

# Zoho Mail
EMAIL_HOST=<email_host>
EMAIL_PASSWORD=<email_password>
NO_REPLY_EMAIL=no-reply@anixlab.in
CONTACT_EMAIL=contact@anixlab.in"


################################################
######### Local Environment Variables #########
################################################

# This is the base URL for the tools app.
BASE_URL=https://tools.anixlab.in

# Database URIs
MONGODB_URI_SHORTURLS=<mongodb_uri>
MONGODB_URI_IMAGEUPLOADS=<mongodb_uri>

# Short URL Details
SHORT_URL=i.anixlab.in
URL_SHORTENER_TOKEN=<url_shortener_token>

# Imgur Details
IMGUR_IMAGE_URL=https://i.imgur.com
IMGUR_CLIENT_ID_1=<imgur_client_id>
IMGUR_CLIENT_SECRET_1=<imgur_client_secret>

# Vercel Blob Storage 
BLOB_READ_WRITE_TOKEN=<blob_read_write_token>
BLOB_BASE_URL=https://<blob_id>.public.blob.vercel-storage.com
