################################################
######### Global Environment Variables #########
################################################

# production or development
NODE_ENV=production

# owner details
OWNER_EMAIL=<owner_email>

# Database URIs
MONGODB_URI_AUTH=<mongodb_uri>

# Auth Details
AUTH_GOOGLE_ID=<google_client_id>
AUTH_GOOGLE_SECRET=<google_client_secret>
BETTER_AUTH_SECRET=<better_auth_secret>
NEXT_PUBLIC_AUTH_BASE_URL=https://api.anixlab.in

# Zoho Mail
EMAIL_HOST=<email_host>
EMAIL_PASSWORD=<email_password>
NO_REPLY_EMAIL=no-reply@anixlab.in
CONTACT_EMAIL=contact@anixlab.in


################################################
######### Local Environment Variables #########
################################################

# This is the base URL for the app.
BASE_URL=https://admin.anixlab.in

# Database URIs
MONGODB_URI_SHORTURLS=<mongodb_uri_shorturls>
MONGODB_URI_IMAGEUPLOADS=<mongodb_uri_imageuploads>

# Short URL Details
SHORT_URL=i.anixlab.in
URL_SHORTENER_TOKEN=<url_shortener_token>

# App URLs
APP_WEB_URL=https://www.anixlab.in
APP_API_URL=https://api.anixlab.in
APP_TOOLS_URL=https://tools.anixlab.in
APP_ANIPIC_URL=https://anipic.anixlab.in
APP_URL_SHORTENER_URL=https://i.anixlab.in
